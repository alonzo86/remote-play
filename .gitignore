.DS_Store

# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# Export output and generated Android build template
build/
android/build/
android/.build_version
android-tv/build/
android-tv/.build_version
# The iPhone QR scanner plugin: built on the Mac by tools/build_ios_plugin.sh, never committed (issue #299). ios/plugin/ is the source.
ios/plugins/
*.apk
*.aab

# Signing material: never commit it (docs/EXPORT.md, "Release to the stores")
*.keystore
*.jks
*.p12

# Godot makes an .import file for every image it sees, also the store images that the app does not use
docs/store-assets/**/*.import
